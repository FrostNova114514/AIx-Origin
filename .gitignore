# AIx Origin Website

# Local secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12

# Python / Django
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.Python
.pytest_cache/
.coverage
htmlcov/
staticfiles/
media/
db.sqlite3
*.sqlite3

# Django runtime / local exports
backups/
logs/
*.log
*.pid
*.sock

# Node / Vue
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# Uploaded/imported private data
*.base
*.sql
*.dump
*.backup
*.bak

# Keep migration files tracked
!website/migrations/
!website/migrations/*.py
!website/migrations/__init__.py
