MYSQL_DATABASE=aixorigin
MYSQL_USER=aixorigin
MYSQL_PASSWORD=replace-with-a-secure-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
DEFAULT_FROM_EMAIL=AIxOrigin <no-reply@aixorigin.innoai.org.cn>
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=replace-with-email-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=30
EMAIL_SUBJECT_PREFIX=[AIxOrigin] 
