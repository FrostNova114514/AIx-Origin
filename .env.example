MYSQL_DATABASE=aixorigin
MYSQL_USER=aixorigin
MYSQL_PASSWORD=replace-with-a-secure-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
DEFAULT_FROM_EMAIL=InnoAI AIxOrigin <aixorigin@mail.innoai.org.cn>
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.qiye.aliyun.com
EMAIL_PORT=465
EMAIL_HOST_USER=aixorigin@mail.innoai.org.cn
EMAIL_HOST_PASSWORD=replace-with-mailbox-password-or-smtp-auth-code
EMAIL_USE_TLS=false
EMAIL_USE_SSL=true
EMAIL_TIMEOUT=30
EMAIL_SUBJECT_PREFIX=[AIxOrigin] 
